  m_Name: 05_StochasticDynamics
  m_EditorClassIdentifier: 
  PresetId: stochastic-dynamics
  PresetName: Stochastic Dynamics
  Description: "High perturbation creates unpredictable patterns. Demonstrates deterministic
    chaos where small changes cascade. Despite appearing random, results are 100%
    reproducible with same seed.\r"
  GridWidth: 128
  GridHeight: 128
  InitialResourceGlobal: 10000000
  ScaleFactor: 1
  DeltaTime: 1
  Parameters:
  - Key: decayLoss
    Value: 0.003
  - Key: resourceGlobalMax
    Value: 50000000
  - Key: globalReplenishPerTick
    Value: 200
  - Key: ethreshBase
    Value: 0.18
  - Key: globalScarcityK
    Value: 0.3
  - Key: propagateFrac
    Value: 0.25
  - Key: regionExpansionChance
    Value: 0.2
  - Key: complexityDiffusionRate
    Value: 0.2
  - Key: complexityDecay
    Value: 0.02
  - Key: perturbationProbability
    Value: 0.0002
  MechanismConfig:
    InflowMode: 0
    BoundaryMode: 2
    DiffusionMode: 1
    ViabilityRule: 0
    TopologyMode: 0
    MaskShape: 1
    MaskRadiusOuter: 20
    MaskRadiusInner: 10
    MaskCorridorWidth: 8
    MaskPercolationProbability: 0.3
    PointSources: []
    HysteresisOnThreshold: 0.5
    HysteresisOffThreshold: -0.5
    AnisotropicDirection: 0
    AnisotropicBias: 0.7
